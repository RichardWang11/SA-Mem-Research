+_RELATIVE_TEMPORAL_RE = re.compile(
+    r"(?:"
+    r"\b(?:today|yesterday|tomorrow|tonight|now|recently|lately|currently|"
+    r"presently|previously|earlier|later|soon|the\s+other\s+day)\b"
